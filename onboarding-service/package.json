{
  "name": "workhub-onboarding-service",
  "version": "0.1.0",
  "private": true,
  "description": "WorkHub 本機上架管理服務：ZIP 收件、建置、檢查、測試、預覽與發布紀錄（本機試點）",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:relay": "python3 -m unittest relay/test_llm_relay.py"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19"
  }
}
